{
  "name": "LinkedIn Weekly Post Automation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtDay": 3,
              "triggerAtHour": 10
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every Wednesday 10AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "={{ $json.sheetUrl || '' }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "gid=0"
        },
        "options": {
          "range": "",
          "dataLocationOnSheet": {
            "rangeDefinition": "detectAutomatically"
          }
        }
      },
      "id": "google-sheets-read",
      "name": "Read Topics from Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [260, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets OAuth2 - Configure Me"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "filter-posted",
              "leftValue": "={{ $json.Status }}",
              "rightValue": "posted",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "filter-unposted",
      "name": "Filter Unposted Topics",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "maxItems": 1
      },
      "id": "limit-one",
      "name": "Pick First Topic",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [720, 300]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-2.0-flash"
        },
        "promptType": "define",
        "text": "={{ \"You are a professional LinkedIn content creator. Write an engaging LinkedIn post about the following topic:\\n\\nTopic: \" + $json.Topic + \"\\n\\nAdditional context: \" + ($json.Details || 'None') + \"\\n\\nRequirements:\\n- Write in a professional but conversational tone\\n- Include relevant hashtags (3-5)\\n- Keep it between 150-300 words\\n- Start with a hook that grabs attention\\n- End with a call to action or question to drive engagement\\n- Use line breaks for readability\\n- Do NOT use emojis excessively, keep it professional\\n\\nIMPORTANT: Return ONLY the plain post text, ready to copy and paste. Do NOT wrap it in JSON, do NOT use keys like 'post' or 'text', do NOT add quotes around it, do NOT use any code formatting. Just the raw post content as plain text.\" }}",
        "options": {
          "temperature": 0.7,
          "maxOutputTokens": 1024
        }
      },
      "id": "gemini-generate-post",
      "name": "Generate Post with Gemini",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [960, 300],
      "credentials": {
        "googleGeminiApi": {
          "id": "",
          "name": "Google Gemini API - Configure Me"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Clean the Gemini response: strip JSON wrapping, escape chars, etc.\nlet raw = $input.first().json.text || $input.first().json.output || '';\n\n// If the response is wrapped in JSON like {\"post\": \"...\"}, extract the value\ntry {\n  const parsed = JSON.parse(raw);\n  if (typeof parsed === 'object' && parsed !== null) {\n    // Extract the first string value found (could be 'post', 'text', 'content', etc.)\n    raw = parsed.post || parsed.text || parsed.content || parsed.message || Object.values(parsed).find(v => typeof v === 'string') || raw;\n  }\n} catch (e) {\n  // Not JSON, use as-is — this is the expected case\n}\n\n// Clean up escaped characters that may remain\nlet clean = raw\n  .replace(/\\\\n/g, '\\n')    // convert literal \\n to real newlines\n  .replace(/\\\\t/g, '\\t')    // convert literal \\t to real tabs\n  .replace(/\\\\\"/g, '\"')     // convert escaped quotes\n  .replace(/^\"|\"$/g, '')    // remove surrounding quotes if present\n  .trim();\n\nreturn [{ json: { text: clean } }];"
      },
      "id": "clean-gemini-output",
      "name": "Clean AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1080, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "set-post-text",
              "name": "postText",
              "value": "={{ $json.text }}",
              "type": "string"
            },
            {
              "id": "set-topic",
              "name": "topic",
              "value": "={{ $('Pick First Topic').item.json.Topic }}",
              "type": "string"
            },
            {
              "id": "set-row-number",
              "name": "rowNumber",
              "value": "={{ $('Pick First Topic').item.json.row_number }}",
              "type": "number"
            },
            {
              "id": "set-image-prompt",
              "name": "imagePrompt",
              "value": "={{ 'Professional, modern illustration for a LinkedIn post about: ' + $('Pick First Topic').item.json.Topic + '. Clean design, corporate style, high quality.' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-fields",
      "name": "Prepare Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1320, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.nanobanana.com/v1/generate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ prompt: $json.imagePrompt, style: 'professional', width: 1200, height: 627 }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "imageData"
            }
          }
        }
      },
      "id": "generate-image",
      "name": "Generate Image (Nano Banana)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Nano Banana API Key - Configure Me"
        }
      },
      "notes": "Configure this node with your Nano Banana image generation API credentials."
    },
    {
      "parameters": {
        "person": "urn:li:person:YOUR_LINKEDIN_PERSON_URN",
        "text": "={{ $json.postText }}",
        "mediaCategory": "IMAGE",
        "additionalFields": {}
      },
      "id": "linkedin-create-post",
      "name": "Create LinkedIn Post",
      "type": "n8n-nodes-base.linkedIn",
      "typeVersion": 1,
      "position": [1800, 300],
      "credentials": {
        "linkedInOAuth2Api": {
          "id": "",
          "name": "LinkedIn OAuth2 - Configure Me"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "={{ $('Read Topics from Google Sheets').params.documentId.value }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "gid=0"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Status": "posted",
            "PostedDate": "={{ $now.format('yyyy-MM-dd HH:mm') }}",
            "row_number": "={{ $('Prepare Data').item.json.rowNumber }}"
          },
          "matchingColumns": ["row_number"]
        },
        "options": {}
      },
      "id": "update-sheet-status",
      "name": "Mark Topic as Posted",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [2040, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets OAuth2 - Configure Me"
        }
      }
    }
  ],
